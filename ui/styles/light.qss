/* ================================================
   ReservasiKampus  Light Mode Industrial Glass
   Palet: Warm White + Teal Elektrik
   ================================================ */

/*  Global  */
QWidget {
    font-family: 'DM Sans', 'Segoe UI', 'Helvetica Neue', sans-serif;
    background-color: #f4f4f8;
    color: #0e0e1a;
    font-size: 13px;
}

QScrollBar:vertical {
    background: #eaeaef;
    width: 6px;
    border-radius: 3px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: #c4c4d0;
    border-radius: 3px;
    min-height: 32px;
}
QScrollBar::handle:vertical:hover {
    background: #00b8a9;
}
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical { height: 0px; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}

/*  Admin Dashboard Dynamic Typography  */
.dashboard_section_title {
    font-size: 12px;
    font-weight: 700;
    color: #6b5e8a;
    background-color: transparent;
}

.dashboard_legend_text {
    font-size: 11px;
    font-weight: 600;
    color: #8888a0;
    background-color: transparent;
}

.kpi_title {
    font-size: 11px;
    font-weight: 700;
    color: #6b5e8a;
    background-color: transparent;
}

.building_name {
    font-size: 12px;
    font-weight: 600;
    color: #0e0e1a;
    background-color: transparent;
}

.building_pct {
    font-size: 11px;
    font-weight: bold;
    color: #00b8a9;
    background-color: transparent;
}

QTableWidget#aktivitas_table {
    background-color: transparent;
    border: none;
}

QTableWidget#aktivitas_table::item {
    border-bottom: 1px solid #e2e2ea;
    padding: 6px;
}

QScrollBar:horizontal {
    background: #eaeaef;
    height: 6px;
    border-radius: 3px;
}
QScrollBar::handle:horizontal {
    background: #c4c4d0;
    border-radius: 3px;
    min-width: 32px;
}
QScrollBar::handle:horizontal:hover {
    background: #00b8a9;
}
QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal { width: 0px; }

/*  Header  */
#header {
    background-color: #ffffff;
    border-bottom: 1px solid #e2e2ea;
    min-height: 52px;
    max-height: 52px;
}

#header QLabel {
    background-color: transparent;
    color: #0e0e1a;
}

#logo_container {
    background-color: rgba(0, 184, 169, 0.05);
    border: 1px solid rgba(0, 184, 169, 0.2);
    border-radius: 8px;
    padding: 0px;
}

#header_title {
    font-size: 14px;
    font-weight: 700;
    color: #0e0e1a;
    letter-spacing: -0.3px;
}

#header_subtitle {
    font-size: 12px;
    color: #6b6b80;
}

#header_time {
    background-color: #f4f4f8;
    border: 1px solid #e2e2ea;
    border-radius: 6px;
    padding: 4px 10px;
    font-size: 11px;
    color: #6b6b80;
}

/*  Login Button (header)  */
#login_btn {
    border: 1px solid rgba(0, 184, 169, 0.35);
    color: #00917f;
    border-radius: 6px;
    padding: 5px 14px;
    font-size: 12px;
    font-weight: 700;
    background-color: rgba(0, 184, 169, 0.07);
}

#login_btn:hover {
    background-color: rgba(0, 184, 169, 0.14);
    border-color: #00b8a9;
    color: #007a6a;
}

#login_btn:pressed {
    background-color: rgba(0, 184, 169, 0.22);
}

/*  Theme Toggle  */
#theme_toggle {
    background-color: #f4f4f8;
    border: 1px solid #e2e2ea;
    border-radius: 6px;
    padding: 4px 10px;
    font-size: 14px;
    color: #0e0e1a;
    min-width: 32px;
    max-height: 28px;
}

#theme_toggle:hover {
    background-color: #eaeaef;
    border-color: #00b8a9;
}

/*  Filter Section  */
#filter_section {
    background-color: #f4f4f8;
    border-bottom: 1px solid #e2e2ea;
    padding: 10px 0px;
}

.filter_tab {
    background: transparent;
    border: none;
    color: #8888a0;
    font-size: 13px;
    font-weight: 600;
    padding: 8px 0px;
}

.filter_tab:hover {
    color: #0e0e1a;
}

.filter_tab[class="filter_tab active"] {
    color: #00b8a9;
    font-weight: 700;
}

#stats_text {
    color: #8888a0;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1px;
    background-color: transparent;
}

/*  Inputs & Comboboxes  */
QLineEdit,
QComboBox {
    background-color: #ffffff;
    border: 1px solid #d8d8e4;
    border-radius: 8px;
    padding: 8px 12px;
    font-size: 13px;
    color: #0e0e1a;
    selection-background-color: rgba(0, 184, 169, 0.15);
}

QLineEdit::placeholder {
    color: #aaaabc;
}

QLineEdit:focus,
QComboBox:focus {
    border: 1px solid #00b8a9;
    background-color: rgba(0, 184, 169, 0.03);
}

QComboBox::drop-down {
    border: none;
    width: 20px;
}

QComboBox::down-arrow {
    width: 10px;
    height: 10px;
}

QComboBox QAbstractItemView {
    background-color: #ffffff;
    border: 1px solid #d8d8e4;
    border-radius: 8px;
    color: #0e0e1a;
    selection-background-color: rgba(0, 184, 169, 0.10);
    outline: none;
}

/*  Main Canvas  */
#main_canvas {
    background-color: #f4f4f8;
    border: none;
}

#main_canvas > QWidget {
    background-color: #f4f4f8;
}

/*  Section Label  */
#section_label {
    font-size: 10px;
    font-weight: 700;
    color: #aaaabc;
    letter-spacing: 1.5px;
    background-color: transparent;
    padding: 0px;
    text-transform: uppercase;
}

/* Room Card */
.room_card {
    background-color: #ffffff;
    border: 1px solid #e2e2ea;
    border-radius: 12px;
    padding: 14px;
    min-width: 120px;
    max-width: 340px;
}

.room_card:hover {
    background-color: #fafafa;
    border: 1px solid #c8c8d8;
}

.dashboard_card {
    background-color: #ffffff;
    border: 1px solid #e2e2ea;
    border-radius: 12px;
    padding: 14px;
    min-width: 120px;
}

.dashboard_card:hover {
    background-color: #fafafa;
    border: 1px solid #c8c8d8;
}

.room_title {
    font-size: 15px;
    font-weight: 700;
    color: #0e0e1a;
    background-color: transparent;
    letter-spacing: -0.3px;
}

.room_details {
    font-size: 11px;
    color: #8888a0;
    background-color: transparent;
}

.card_bottom_info {
    font-size: 12px;
    font-weight: 600;
    color: #6b6b80;
    background-color: transparent;
    padding-top: 4px;
}

/*  Status Badges  */
.badge {
    border-radius: 5px;
    padding: 3px 9px;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.5px;
    text-transform: uppercase;
}

.badge_available {
    background-color: rgba(16, 185, 129, 0.10);
    color: #057a5c;
    border: 1px solid rgba(16, 185, 129, 0.22);
}

.badge_in_use {
    background-color: rgba(239, 68, 68, 0.10);
    color: #c01c3c;
    border: 1px solid rgba(239, 68, 68, 0.22);
}

.badge_booked {
    background-color: rgba(251, 191, 36, 0.12);
    color: #a06010;
    border: 1px solid rgba(251, 191, 36, 0.28);
}

.badge_unavailable {
    background-color: rgba(107, 114, 128, 0.10);
    color: #6b7280;
    border: 1px solid rgba(107, 114, 128, 0.20);
}

/*  Footer  */
#footer {
    background-color: #ffffff;
    border-top: 1px solid #e2e2ea;
    min-height: 40px;
    max-height: 40px;
}

#footer QLabel {
    color: #aaaabc;
    font-size: 11px;
    background-color: transparent;
}

#footer_contact {
    color: #8888a0;
    font-size: 11px;
    background-color: transparent;
}

/*  Notification Banner  */
#notif_banner {
    background-color: rgba(245, 158, 11, 0.06);
    border-top: 1px solid rgba(217, 119, 6, 0.25);
    border-bottom: 1px solid rgba(217, 119, 6, 0.25);
    min-height: 36px;
}

#notif_text {
    color: #b45309;
    font-size: 11px;
    font-weight: 600;
    background-color: transparent;
}

#dismiss_btn {
    background-color: transparent;
    border: 1px solid rgba(217, 119, 6, 0.25);
    border-radius: 50%;
    color: #b45309;
    font-size: 11px;
    font-weight: bold;
    min-width: 20px;
    max-width: 20px;
    min-height: 20px;
    max-height: 20px;
}

#dismiss_btn:hover {
    background-color: rgba(245, 158, 11, 0.12);
}

/*  Sidebar  */
#sidebar {
    background-color: #ffffff;
    border-right: 1px solid #e2e2ea;
}

#sidebar QLabel {
    background-color: transparent;
}

#sidebar_title_lbl {
    font-size: 13px;
    font-weight: 700;
    color: #0e0e1a;
    background-color: transparent;
}

#sidebar_subtitle_lbl {
    font-size: 10px;
    color: #aaaabc;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    background-color: transparent;
}

#sidebar QPushButton {
    text-align: left;
    padding: 8px 12px;
    border-radius: 6px;
    font-size: 13px;
    font-weight: 500;
    color: #6b6b80;
    border: none;
    background: none;
}

#sidebar QPushButton[class="active"] {
    background-color: rgba(0, 184, 169, 0.10);
    color: #00917f;
    border-left: 2px solid #00b8a9;
    border-radius: 0 6px 6px 0;
    padding-left: 14px;
}

#sidebar QPushButton:hover:not([class="active"]) {
    background-color: #f4f4f8;
    color: #0e0e1a;
}

#logout_btn {
    background-color: rgba(239, 68, 68, 0.05);
    color: #dc2626;
    border: 1px solid rgba(239, 68, 68, 0.15);
    border-radius: 6px;
    font-weight: 600;
    font-size: 13px;
}

#logout_btn:hover {
    background-color: #ef4444;
    color: #ffffff;
    border-color: #ef4444;
}


/*  QTableWidget & Tables  */
QTableWidget {
    background-color: #ffffff;
    border: 1px solid #e2e2ea;
    border-radius: 10px;
    gridline-color: #f0f0f5;
    color: #0e0e1a;
    selection-background-color: rgba(0, 184, 169, 0.08);
}

QTableWidget::item {
    padding: 8px;
    border-bottom: 1px solid #f0f0f5;
}

QTableWidget::item:selected {
    background-color: rgba(0, 184, 169, 0.10);
    color: #0e0e1a;
}

QTableWidget::item:hover {
    background-color: #fafafa;
}

QHeaderView::section {
    background-color: #f4f4f8;
    color: #aaaabc;
    padding: 8px 12px;
    border: none;
    border-bottom: 1px solid #e2e2ea;
    font-weight: 700;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.8px;
}

QTableWidget QTableCornerButton::section {
    background-color: #f4f4f8;
    border: none;
}

/*  Table Action Buttons  */
#edit_action_btn {
    background-color: rgba(0, 184, 169, 0.08);
    color: #00917f;
    border: 1px solid rgba(0, 184, 169, 0.22);
    border-radius: 5px;
    font-weight: 700;
    font-size: 11px;
}

#edit_action_btn:hover {
    background-color: #00b8a9;
    color: #ffffff;
    border-color: #00b8a9;
}

#delete_action_btn {
    background-color: rgba(239, 68, 68, 0.07);
    color: #dc2626;
    border: 1px solid rgba(239, 68, 68, 0.18);
    border-radius: 5px;
    font-weight: 700;
    font-size: 11px;
}

#delete_action_btn:hover {
    background-color: #ef4444;
    color: #ffffff;
    border-color: #ef4444;
}

/*  Login Page  */
#login_container {
    background-color: transparent;
}

#form_card,
#login_container #form_card {
    background-color: #ffffff;
    border: 1px solid #e2e2ea;
    border-radius: 20px;
}

#login_app_title {
    font-size: 22px;
    font-weight: 700;
    color: #0e0e1a;
    background-color: transparent;
    letter-spacing: -0.5px;
}

#page_title_lbl {
    font-size: 13px;
    font-weight: 400;
    color: #8888a0;
    background-color: transparent;
}

#username_lbl,
#password_lbl {
    font-size: 10px;
    font-weight: 700;
    color: #8888a0;
    background-color: transparent;
    text-transform: uppercase;
    letter-spacing: 0.8px;
}

#login_container #login_btn {
    background-color: #00b8a9;
    color: #ffffff;
    border: none;
    border-radius: 8px;
    font-weight: 700;
    font-size: 13px;
    padding: 10px 0;
}

#login_container #login_btn:hover {
    background-color: #009f92;
    color: #ffffff;
}

#back_btn {
    background-color: transparent;
    border: 1px solid #e2e2ea;
    color: #8888a0;
    border-radius: 8px;
    font-weight: 600;
    font-size: 13px;
}

#back_btn:hover {
    border-color: #c8c8d8;
    color: #0e0e1a;
    background-color: #f4f4f8;
}

/*  Form Dialog Controls  */
#cancel_btn {
    background-color: transparent;
    color: #8888a0;
    border: 1px solid #e2e2ea;
    border-radius: 8px;
    font-weight: 600;
}

#cancel_btn:hover {
    background-color: #f4f4f8;
    color: #0e0e1a;
}

/*  Facility Chip  */
.facility_chip {
    background-color: #f4f4f8;
    color: #6b6b80;
    border: 1px solid #e2e2ea;
    border-radius: 4px;
    padding: 2px 7px;
    font-size: 10px;
    font-weight: 600;
}

/*  QMessageBox  */
QMessageBox {
    background-color: #ffffff;
    color: #0e0e1a;
}

QMessageBox QPushButton {
    background-color: #f4f4f8;
    border: 1px solid #d8d8e4;
    border-radius: 6px;
    color: #0e0e1a;
    padding: 6px 16px;
    min-width: 60px;
}

QMessageBox QPushButton:hover {
    background-color: #eaeaef;
    border-color: #00b8a9;
    color: #00917f;
}

/*  QDialog  */
QDialog {
    background-color: #ffffff;
    border: 1px solid #e2e2ea;
    border-radius: 16px;
}

/*  Progress Bar (Utilitas Gedung)  */
QProgressBar {
    background-color: #f0f0f5;
    border: none;
    border-radius: 4px;
    max-height: 6px;
}

QProgressBar::chunk {
    background-color: #00b8a9;
    border-radius: 4px;
}

/* Admin Dashboard Specific */
#AdminDashboard { background-color: #f0f4ff; }
#Sidebar { background-color: #1c1854; border-right: 1px solid rgba(255,255,255,0.05); }
#MainFrame { background-color: #f0f4ff; }
QLabel#PageTitle { font-size:20px; font-weight:900; color:#0f172a; background-color: transparent; }
QLabel#TimeLabel { font-size:12px; color:#64748b; background-color: transparent; }
QPushButton#ThemeBtn { background-color: #ffffff; color: #334155; border: 1px solid #e4e9f5; border-radius: 10px; font-weight: 600; font-size: 11px; padding: 5px; }
QPushButton#ThemeBtn:hover { background-color: #f8faff; }
#WarnBanner { background-color: #fff7ed; border: 1px solid #fed7aa; border-radius: 10px; }
QLabel#WarnText { color: #c2410c; font-weight: 700; font-size: 12px; background-color: transparent; }
QLabel#SectionTitle { font-size: 15px; font-weight: 800; color: #0f172a; background-color: transparent; }
QLineEdit#SearchBox { background-color: #ffffff; border: 1px solid #e4e9f5; border-radius: 8px; padding: 5px 10px; color: #334155; font-size: 12px; }
#KpiCard { background-color: #ffffff; border: 1px solid #e4e9f5; border-radius: 12px; }
QLabel#KpiTitle { font-size: 11px; font-weight: 700; color: #94a3b8; background-color: transparent; }
QLabel#KpiValue { font-size: 28px; font-weight: 900; color: #4f46e5; background-color: transparent; }
#DetailPanel { background-color: #ffffff; border-left: 1px solid #e4e9f5; }
QLabel#PanelHeader { font-size: 14px; font-weight: 800; color: #0f172a; background-color: transparent; }
QLabel#PanelName { font-size: 18px; font-weight: 800; color: #0f172a; background-color: transparent; }
QLabel#PanelStatus { background-color: #f8faff; color: #64748b; border: 1px solid #e4e9f5; border-radius: 8px; padding: 6px; font-size: 12px; font-weight: 600; }
#InfoBox { background-color: transparent; border: none; }
QLabel#InfoLabel { color: #94a3b8; font-size: 11px; font-weight: 700; background-color: transparent; }
QLabel#InfoUser { color: #64748b; font-size: 12px; font-weight: 600; background-color: transparent; }

/* Nav Buttons */
QPushButton#NavBtn { background-color: transparent; color: #94a3b8; border: none; font-size: 13px; font-weight: 600; text-align: left; padding: 8px 16px; border-radius: 8px; margin: 2px 12px; }
QPushButton#NavBtn:hover { background-color: rgba(255,255,255,0.05); color: #ffffff; }
QPushButton#NavBtn:checked { background-color: rgba(255,255,255,0.1); color: #ffffff; font-weight: 800; }

/* Room Card */
#RoomCard { background-color: #ffffff; border: 1px solid #e4e9f5; border-radius: 12px; }
#RoomCard:hover { border: 1px solid #4f46e5; background-color: #f8faff; }
QLabel.roomcard_title { color: #0f172a; font-size: 15px; font-weight: 800; background-color: transparent; }
QLabel#CardMeta { color: #64748b; font-size: 11px; background-color: transparent; }

/* Mahasiswa Dashboard */
#btn_reservasi_baru {
    background-color: #22c55e;
    color: #ffffff;
    border: none;
    border-radius: 10px;
    padding: 0 20px;
    font-weight: 800;
    font-size: 13px;
}

#btn_reservasi_baru:hover {
    background-color: #16a34a;
}

#page_title {
    font-size: 28px;
    font-weight: 800;
    color: #0f172a;
    background-color: transparent;
}

#page_subtitle {
    font-size: 14px;
    color: #64748b;
    background-color: transparent;
}

#stats_label {
    font-size: 12px;
    font-weight: 700;
    color: #6b6b80;
    letter-spacing: 0.8px;
    background-color: transparent;
}

#section_title {
    font-size: 18px;
    font-weight: 800;
    color: #0f172a;
    background-color: transparent;
}

#sidebar_logo {
    color: #f1f5f9;
    font-size: 18px;
    font-weight: 800;
    background-color: transparent;
}
