/* ================================================
   ReservasiKampus — Dark Industrial Glass
   Palet: Deep Black + Teal Elektrik
   ================================================ */

/* ── Global ──────────────────────────────────────── */
QWidget {
    font-family: 'DM Sans', 'Segoe UI', 'Helvetica Neue', sans-serif;
    background-color: #0a0a0f;
    color: #e8e8f0;
    font-size: 13px;
}

QScrollBar:vertical {
    background: #0f0f18;
    width: 6px;
    border-radius: 3px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: #2a2a40;
    border-radius: 3px;
    min-height: 32px;
}
QScrollBar::handle:vertical:hover {
    background: #00e5cc;
}
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical { height: 0px; }
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical { background: none; }

QScrollBar:horizontal {
    background: #0f0f18;
    height: 6px;
    border-radius: 3px;
}
QScrollBar::handle:horizontal {
    background: #2a2a40;
    border-radius: 3px;
    min-width: 32px;
}
QScrollBar::handle:horizontal:hover {
    background: #00e5cc;
}
QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal { width: 0px; }

/* ── Header ─────────────────────────────────────── */
#header {
    background-color: #0f0f18;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    min-height: 52px;
    max-height: 52px;
}

#header QLabel {
    background-color: transparent;
    color: #e8e8f0;
}

#header_title {
    font-size: 14px;
    font-weight: 700;
    color: #e8e8f0;
    letter-spacing: -0.3px;
}

#header_subtitle {
    font-size: 12px;
    color: #888898;
}

#header_time {
    background-color: #1a1a2e;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 6px;
    padding: 4px 10px;
    font-size: 11px;
    color: #8888a8;
}

/* ── Login Button (header) ─────────────────────── */
#login_btn {
    border: 1px solid rgba(0, 229, 204, 0.25);
    color: #00e5cc;
    border-radius: 6px;
    padding: 5px 14px;
    font-size: 12px;
    font-weight: 700;
    background-color: rgba(0, 229, 204, 0.06);
}

#login_btn:hover {
    background-color: rgba(0, 229, 204, 0.14);
    border-color: rgba(0, 229, 204, 0.5);
    color: #ffffff;
}

#login_btn:pressed {
    background-color: rgba(0, 229, 204, 0.22);
}

/* ── Theme Toggle ────────────────────────────────── */
#theme_toggle {
    background-color: #1a1a2e;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 6px;
    padding: 4px 10px;
    font-size: 14px;
    color: #e8e8f0;
    min-width: 32px;
    max-height: 28px;
}

#theme_toggle:hover {
    background-color: #22223a;
    border-color: rgba(0, 229, 204, 0.3);
}

/* ── Filter Section ──────────────────────────────── */
#filter_section {
    background-color: #0f0f18;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    padding: 10px 0px;
}

.stat_chip {
    background-color: #141420;
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 20px;
    padding: 5px 12px;
}

.stat_chip QLabel {
    background-color: transparent;
    color: #8888a8;
    font-size: 12px;
    font-weight: 600;
}

/* ── Inputs & Comboboxes ─────────────────────────── */
QLineEdit,
QComboBox {
    background-color: #1a1a2e;
    border: 1px solid rgba(255, 255, 255, 0.10);
    border-radius: 8px;
    padding: 8px 12px;
    font-size: 13px;
    color: #e8e8f0;
    selection-background-color: rgba(0, 229, 204, 0.2);
}

QLineEdit::placeholder {
    color: #555570;
}

QLineEdit:focus,
QComboBox:focus {
    border: 1px solid #00e5cc;
    background-color: rgba(0, 229, 204, 0.04);
}

QComboBox::drop-down {
    border: none;
    width: 20px;
}

QComboBox::down-arrow {
    width: 10px;
    height: 10px;
}

QComboBox QAbstractItemView {
    background-color: #141420;
    border: 1px solid rgba(255, 255, 255, 0.10);
    border-radius: 8px;
    color: #e8e8f0;
    selection-background-color: rgba(0, 229, 204, 0.12);
    outline: none;
}

/* ── Main Canvas ─────────────────────────────────── */
#main_canvas {
    background-color: #0a0a0f;
    border: none;
}

#main_canvas > QWidget {
    background-color: #0a0a0f;
}

/* ── Section Label ───────────────────────────────── */
#section_label {
    font-size: 10px;
    font-weight: 700;
    color: #555570;
    letter-spacing: 1.5px;
    background-color: transparent;
    padding: 0px;
    text-transform: uppercase;
}

/* ── Room Cards ──────────────────────────────────── */
.room_card {
    background-color: #141420;
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 12px;
    padding: 14px;
    min-width: 120px;
    max-width: 340px;
}

.room_card:hover {
    background-color: #1a1a2e;
    border: 1px solid rgba(255, 255, 255, 0.12);
}

.dashboard_card {
    background-color: #141420;
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 12px;
    padding: 14px;
    min-width: 120px;
}

.dashboard_card:hover {
    background-color: #1a1a2e;
    border: 1px solid rgba(255, 255, 255, 0.12);
}

.room_title {
    font-size: 15px;
    font-weight: 700;
    color: #e8e8f0;
    background-color: transparent;
    letter-spacing: -0.3px;
}

.room_details {
    font-size: 11px;
    color: #8888a8;
    background-color: transparent;
}

.card_bottom_info {
    font-size: 12px;
    font-weight: 600;
    color: #8888a8;
    background-color: transparent;
    padding-top: 4px;
}

/* ── Status Badges ───────────────────────────────── */
.badge {
    border-radius: 5px;
    padding: 3px 9px;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.5px;
    text-transform: uppercase;
}

.badge_available {
    background-color: rgba(16, 185, 129, 0.12);
    color: #10b981;
    border: 1px solid rgba(16, 185, 129, 0.22);
}

.badge_in_use {
    background-color: rgba(255, 77, 109, 0.12);
    color: #ff4d6d;
    border: 1px solid rgba(255, 77, 109, 0.22);
}

.badge_booked {
    background-color: rgba(251, 191, 36, 0.12);
    color: #fbbf24;
    border: 1px solid rgba(251, 191, 36, 0.22);
}

.badge_unavailable {
    background-color: rgba(107, 114, 128, 0.12);
    color: #6b7280;
    border: 1px solid rgba(107, 114, 128, 0.20);
}

/* ── Footer ──────────────────────────────────────── */
#footer {
    background-color: #0f0f18;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    min-height: 40px;
    max-height: 40px;
}

#footer QLabel {
    color: #555570;
    font-size: 11px;
    background-color: transparent;
}

#footer_contact {
    color: #8888a8;
    font-size: 11px;
    background-color: transparent;
}

/* ── Notification Banner ─────────────────────────── */
#notif_banner {
    background-color: rgba(251, 191, 36, 0.06);
    border-top: 1px solid rgba(251, 191, 36, 0.20);
    border-bottom: 1px solid rgba(251, 191, 36, 0.20);
    min-height: 36px;
}

#notif_text {
    color: #fbbf24;
    font-size: 11px;
    font-weight: 600;
    background-color: transparent;
}

#dismiss_btn {
    background-color: transparent;
    border: 1px solid rgba(251, 191, 36, 0.25);
    border-radius: 50%;
    color: #fbbf24;
    font-size: 11px;
    font-weight: bold;
    min-width: 20px;
    max-width: 20px;
    min-height: 20px;
    max-height: 20px;
}

#dismiss_btn:hover {
    background-color: rgba(251, 191, 36, 0.15);
}

/* ── Sidebar ──────────────────────────────────────── */
#sidebar {
    background-color: #0f0f18;
    border-right: 1px solid rgba(255, 255, 255, 0.05);
}

#sidebar QLabel {
    background-color: transparent;
}

#sidebar_title_lbl {
    font-size: 13px;
    font-weight: 700;
    color: #e8e8f0;
    background-color: transparent;
}

#sidebar_subtitle_lbl {
    font-size: 10px;
    color: #555570;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    background-color: transparent;
}

#sidebar QPushButton {
    text-align: left;
    padding: 8px 12px;
    border-radius: 6px;
    font-size: 13px;
    font-weight: 500;
    color: #8888a8;
    border: none;
    background: none;
}

#sidebar QPushButton[class="active"] {
    background-color: rgba(0, 229, 204, 0.10);
    color: #00e5cc;
    border-left: 2px solid #00e5cc;
    border-radius: 0 6px 6px 0;
    padding-left: 14px;
}

#sidebar QPushButton:hover:not([class="active"]) {
    background-color: rgba(255, 255, 255, 0.04);
    color: #e8e8f0;
}

#logout_btn {
    background-color: rgba(255, 77, 109, 0.06);
    color: #ff4d6d;
    border: 1px solid rgba(255, 77, 109, 0.15);
    border-radius: 6px;
    font-weight: 600;
    font-size: 13px;
}

#logout_btn:hover {
    background-color: #ff4d6d;
    color: #ffffff;
    border-color: #ff4d6d;
}

.stat_chip {
    background-color: transparent;
    border: none;
}

/* ── QTableWidget & Tables ────────────────────────── */
QTableWidget {
    background-color: #0f0f18;
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 10px;
    gridline-color: rgba(255, 255, 255, 0.03);
    color: #e8e8f0;
    selection-background-color: rgba(0, 229, 204, 0.08);
    alternate-background-color: transparent;
}

QTableWidget::item {
    padding: 8px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.03);
}

QTableWidget::item:selected {
    background-color: rgba(0, 229, 204, 0.10);
    color: #ffffff;
}

QTableWidget::item:hover {
    background-color: rgba(255, 255, 255, 0.03);
}

QHeaderView::section {
    background-color: #141420;
    color: #555570;
    padding: 8px 12px;
    border: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    font-weight: 700;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.8px;
}

QTableWidget QTableCornerButton::section {
    background-color: #141420;
    border: none;
}

/* ── Table Action Buttons ────────────────────────── */
#edit_action_btn {
    background-color: rgba(0, 229, 204, 0.08);
    color: #00e5cc;
    border: 1px solid rgba(0, 229, 204, 0.20);
    border-radius: 5px;
    font-weight: 700;
    font-size: 11px;
}

#edit_action_btn:hover {
    background-color: #00e5cc;
    color: #0a0a0f;
    border-color: #00e5cc;
}

#delete_action_btn {
    background-color: rgba(255, 77, 109, 0.08);
    color: #ff4d6d;
    border: 1px solid rgba(255, 77, 109, 0.20);
    border-radius: 5px;
    font-weight: 700;
    font-size: 11px;
}

#delete_action_btn:hover {
    background-color: #ff4d6d;
    color: #ffffff;
    border-color: #ff4d6d;
}

/* ── Login Page ─────────────────────────────────── */
#login_container {
    background-color: transparent;
}

#form_card,
#login_container #form_card {
    background-color: #141420;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 20px;
}

#login_app_title {
    font-size: 22px;
    font-weight: 700;
    color: #e8e8f0;
    background-color: transparent;
    letter-spacing: -0.5px;
}

#page_title_lbl {
    font-size: 13px;
    font-weight: 400;
    color: #8888a8;
    background-color: transparent;
}

#username_lbl,
#password_lbl {
    font-size: 10px;
    font-weight: 700;
    color: #8888a8;
    background-color: transparent;
    text-transform: uppercase;
    letter-spacing: 0.8px;
}

/* Main submit button override */
#login_container #login_btn,
QPushButton#login_btn {
    background-color: #00e5cc;
    color: #0a0a0f;
    border: none;
    border-radius: 8px;
    font-weight: 700;
    font-size: 13px;
    padding: 10px 0;
}

#login_container #login_btn:hover,
QPushButton#login_btn:hover {
    background-color: #00cfb8;
    color: #0a0a0f;
}

#back_btn {
    background-color: transparent;
    border: 1px solid rgba(255, 255, 255, 0.08);
    color: #8888a8;
    border-radius: 8px;
    font-weight: 600;
    font-size: 13px;
}

#back_btn:hover {
    border-color: rgba(255, 255, 255, 0.14);
    color: #e8e8f0;
    background-color: rgba(255, 255, 255, 0.04);
}

/* ── Form Dialog Controls ─────────────────────────── */
#cancel_btn {
    background-color: transparent;
    color: #8888a8;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 8px;
    font-weight: 600;
}

#cancel_btn:hover {
    background-color: rgba(255, 255, 255, 0.04);
    color: #e8e8f0;
}

/* ── Facility Chip ───────────────────────────────── */
.facility_chip {
    background-color: rgba(255, 255, 255, 0.05);
    color: #8888a8;
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 4px;
    padding: 2px 7px;
    font-size: 10px;
    font-weight: 600;
}

/* ── QMessageBox ─────────────────────────────────── */
QMessageBox {
    background-color: #141420;
    color: #e8e8f0;
}

QMessageBox QPushButton {
    background-color: #1a1a2e;
    border: 1px solid rgba(255, 255, 255, 0.10);
    border-radius: 6px;
    color: #e8e8f0;
    padding: 6px 16px;
    min-width: 60px;
}

QMessageBox QPushButton:hover {
    background-color: #22223a;
    border-color: rgba(0, 229, 204, 0.3);
    color: #00e5cc;
}

/* ── QDialog ─────────────────────────────────────── */
QDialog {
    background-color: #141420;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 16px;
}

/* ── Progress Bar (Utilitas Gedung) ──────────────── */
QProgressBar {
    background-color: rgba(255, 255, 255, 0.05);
    border: none;
    border-radius: 4px;
    max-height: 6px;
}

QProgressBar::chunk {
    background-color: #00e5cc;
    border-radius: 4px;
}
